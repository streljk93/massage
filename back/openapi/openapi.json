{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "back"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Проверка доступности сервиса",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "Auth_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "name",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "example": "Jane"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256,
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "accessToken",
                    "refreshToken"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "name": {
                          "type": "string",
                          "example": "Jane Doe"
                        }
                      }
                    },
                    "accessToken": {
                      "type": "string",
                      "description": "JWT access token (Authorization: Bearer …)"
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "JWT refresh token"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации (Zod): неверный формат email, пароль короче 8 символов и т.д."
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "EMAIL_ALREADY_REGISTERED"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Регистрация по email и паролю",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "Auth_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "accessToken",
                    "refreshToken"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "name": {
                          "type": "string",
                          "example": "Jane Doe"
                        }
                      }
                    },
                    "accessToken": {
                      "type": "string",
                      "description": "JWT access token (Authorization: Bearer …)"
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "JWT refresh token"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации тела запроса"
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INVALID_CREDENTIALS",
                        "INVALID_REFRESH_TOKEN",
                        "USER_NOT_FOUND"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Вход по email и паролю",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "Auth_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "description": "JWT refresh token from login or previous refresh"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "accessToken",
                    "refreshToken"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "name": {
                          "type": "string",
                          "example": "Jane Doe"
                        }
                      }
                    },
                    "accessToken": {
                      "type": "string",
                      "description": "JWT access token (Authorization: Bearer …)"
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "JWT refresh token"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации тела запроса"
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INVALID_CREDENTIALS",
                        "INVALID_REFRESH_TOKEN",
                        "USER_NOT_FOUND"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Обновление пары JWT по refresh-токену",
        "tags": [
          "auth"
        ]
      }
    },
    "/catalog/major-categories": {
      "get": {
        "description": "Список активных больших категорий (вертикалей), отсортированных по sortOrder. Названия по query `locale` (en, vi, ru); при отсутствии перевода — fallback en, затем каноническое поле `name` сущности.",
        "operationId": "Catalog_getMajorCategories",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Локаль для локализованных полей из таблиц *Locale (по умолчанию en). Невалидное значение — 400.",
            "schema": {
              "enum": [
                "en",
                "vi",
                "ru"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "majorCategories"
                  ],
                  "properties": {
                    "majorCategories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "slug",
                          "sortOrder"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string",
                            "example": "Массаж"
                          },
                          "slug": {
                            "type": "string",
                            "example": "massage"
                          },
                          "sortOrder": {
                            "type": "integer",
                            "example": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат locale"
          }
        },
        "summary": "Все большие категории услуг",
        "tags": [
          "catalog"
        ]
      }
    },
    "/catalog/major-categories/{majorSlug}/categories/{categorySlug}": {
      "get": {
        "description": "Возвращает большую категорию и одну активную подкатегорию. Названия по query `locale` (en, vi, ru); при отсутствии перевода — fallback en, затем канонические поля сущности.",
        "operationId": "Catalog_getCategoryByMajorAndSlug",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Локаль для локализованных полей из таблиц *Locale (по умолчанию en). Невалидное значение — 400.",
            "schema": {
              "enum": [
                "en",
                "vi",
                "ru"
              ],
              "type": "string"
            }
          },
          {
            "name": "categorySlug",
            "required": true,
            "in": "path",
            "description": "Slug подкатегории (ServiceCategory.slug внутри большой)",
            "schema": {
              "example": "neck"
            }
          },
          {
            "name": "majorSlug",
            "required": true,
            "in": "path",
            "description": "Slug большой категории (MajorServiceCategory.slug)",
            "schema": {
              "example": "massage"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "majorCategory",
                    "category"
                  ],
                  "properties": {
                    "majorCategory": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "slug"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string",
                          "example": "Массаж"
                        },
                        "slug": {
                          "type": "string",
                          "example": "massage"
                        }
                      }
                    },
                    "category": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "shortName",
                        "slug",
                        "description",
                        "sortOrder"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string",
                          "example": "Массаж шеи и зоны декольте"
                        },
                        "shortName": {
                          "type": "string",
                          "example": "шея"
                        },
                        "slug": {
                          "type": "string",
                          "example": "neck"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true
                        },
                        "sortOrder": {
                          "type": "integer",
                          "example": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат majorSlug, categorySlug или locale"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "SERVICE_CATEGORY_NOT_FOUND"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Одна подкатегория по slug внутри большой категории",
        "tags": [
          "catalog"
        ]
      }
    },
    "/catalog/major-categories/{majorSlug}/categories": {
      "get": {
        "description": "Возвращает большую категорию (например massage) и список активных подкатегорий (ServiceCategory), отсортированных по sortOrder. Названия подставляются по query `locale` (en, vi, ru); при отсутствии перевода — fallback en, затем канонические поля сущности.",
        "operationId": "Catalog_getCategoriesByMajorSlug",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Локаль для локализованных полей из таблиц *Locale (по умолчанию en). Невалидное значение — 400.",
            "schema": {
              "enum": [
                "en",
                "vi",
                "ru"
              ],
              "type": "string"
            }
          },
          {
            "name": "majorSlug",
            "required": true,
            "in": "path",
            "description": "Slug большой категории (MajorServiceCategory.slug)",
            "schema": {
              "example": "massage"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "majorCategory",
                    "categories"
                  ],
                  "properties": {
                    "majorCategory": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "slug"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string",
                          "example": "Массаж"
                        },
                        "slug": {
                          "type": "string",
                          "example": "massage"
                        }
                      }
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "shortName",
                          "slug",
                          "description",
                          "sortOrder"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string",
                            "example": "Массаж шеи и зоны декольте"
                          },
                          "shortName": {
                            "type": "string",
                            "example": "шея"
                          },
                          "slug": {
                            "type": "string",
                            "example": "neck"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true
                          },
                          "sortOrder": {
                            "type": "integer",
                            "example": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат majorSlug или locale"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "MAJOR_CATEGORY_NOT_FOUND"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Подкатегории услуг по slug большой категории",
        "tags": [
          "catalog"
        ]
      }
    },
    "/advertisements": {
      "get": {
        "description": "Активные объявления для `placement` (например `home_promo` — карусель на главном экране). Тексты по `locale` (en, vi, ru): запрошенная локаль → en → канонические поля сущности. `ownerKind`: internal — наша реклама, external — партнёр или сторонний инвентарь.",
        "operationId": "Advertising_listByPlacement",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Локаль для локализованных полей из таблиц *Locale (по умолчанию en). Невалидное значение — 400.",
            "schema": {
              "enum": [
                "en",
                "vi",
                "ru"
              ],
              "type": "string"
            }
          },
          {
            "name": "placement",
            "required": true,
            "in": "query",
            "description": "Слот показа: home_promo (главная), в будущем — search_banner и др.",
            "schema": {
              "example": "home_promo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "placement",
                    "items"
                  ],
                  "properties": {
                    "placement": {
                      "type": "string",
                      "example": "home_promo"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "ownerKind",
                          "sortOrder",
                          "imageUrl",
                          "targetUrl",
                          "title",
                          "subtitle",
                          "ctaLabel"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "ownerKind": {
                            "type": "string",
                            "enum": [
                              "internal",
                              "external"
                            ]
                          },
                          "sortOrder": {
                            "type": "integer",
                            "example": 0
                          },
                          "imageUrl": {
                            "type": "string",
                            "format": "uri"
                          },
                          "targetUrl": {
                            "type": "string",
                            "nullable": true,
                            "format": "uri"
                          },
                          "title": {
                            "type": "string",
                            "example": "Скидка 25%"
                          },
                          "subtitle": {
                            "type": "string",
                            "example": "Новым клиентам"
                          },
                          "ctaLabel": {
                            "type": "string",
                            "example": "Регистрация"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат placement или locale"
          }
        },
        "summary": "Реклама и баннеры по слоту показа",
        "tags": [
          "advertising"
        ]
      }
    }
  },
  "info": {
    "title": "Services App API",
    "description": "Backend REST API. Авторизация email/password и JWT; дальнейшие домены — по мере появления модулей.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/v1",
      "description": "Префикс Nest `setGlobalPrefix(\"v1\")`"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {}
  }
}
