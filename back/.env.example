# --- Nest: только то, что не задаётся корневым `.env` для docker-compose ---
#
# Полный стек в Docker: `DATABASE_URL`, `JWT_SECRET`, Redis/S3 для контейнера `back`
# подставляются из compose и корневого `.env` — см. `.env.example` в корне.
#
# Локальный Nest без контейнера back: скопируйте `back/.env.local.example` → `back/.env.local`
# и заполните из корневого `.env` (Postgres/Redis/MinIO на localhost).
#
# Суперадмин и прикладные ключи — ниже (их нет в корневом шаблоне).

# --- Суперадмин платформы (роль master; полный доступ к админ-панели) ---
# `npm run init` дописывает недостающие ключи. В Docker compose сервис `back` подхватывает `back/.env` через `env_file`.
ADMIN_MASTER_NAME=
ADMIN_MASTER_EMAIL=
ADMIN_MASTER_PASSWORD=

# --- HTTP throttle (@nestjs/throttler, in-memory) ---
# HTTP_THROTTLE_TTL_MS=60000
# HTTP_THROTTLE_LIMIT=400

# --- Redis (BullMQ) при **локальном** back: хост и порт; пароль = REDIS_PASSWORD из корня ---
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- Moderation: text (Ollama) ---
# Только база URL, без /api/chat. В compose см. проброс порта (:11435 с хоста).
# Пустой OLLAMA_BASE_URL — текст без AI. ENABLE_OLLAMA=false в compose (дефолт) — бэкенд не зовёт Ollama.
# Локальный контейнер Ollama: `npm run docker:up:dev:ai` или `npm run init`; на хост :11435.
OLLAMA_BASE_URL=http://127.0.0.1:11435
# ENABLE_OLLAMA=true
OLLAMA_MODEL=llama3.2
# OLLAMA_REQUEST_TIMEOUT_MS=90000

# --- Moderation: галерея (image-moderation в compose без порта на хост — см. docker-compose) ---
# В контейнере `back`: http://image-moderation:8085. Nest на хосте: 127.0.0.1:8085 + `docker-compose.override.yml` с 8085:8085.
IMAGE_MODERATION_BASE_URL=http://127.0.0.1:8085
# Для доступа Nest изнутри контейнера модератора (не localhost контейнера):
# MODERATION_FILE_FETCH_ORIGIN=http://host.docker.internal:3001
# MODERATION_IMAGE_UNSAFE_THRESHOLD=0.5
# Порог pairwise CLIP (violence…weapon vs neutral); см. docker/nsfw-image-moderation/app.py
# MODERATION_CLIP_REVIEW_THRESHOLD=0.7
# Отключить второй этап CLIP (оставить только NudeNet): IMAGE_MODERATION_CLIP_ENABLED=false — в контейнере
# MODERATION_IMAGE_REQUEST_TIMEOUT_MS=60000

# Отложенная модерация профиля организации после онбординга: true — через BullMQ (нужны Redis-параметры); false — в том же HTTP-запросе без поднятия Bull в этом приложении для очередей модерации.
MODERATION_QUEUE_ENABLED=true

# --- Слоты в каталоге и на профиле ---
LISTING_CARD_PREVIEW_CALENDAR_DAYS=1
PROFILE_SLOT_PREVIEW_CALENDAR_DAYS=14

# --- Dev (/v1/dev/* вне production) ---
DISABLE_DEV_TEST_ROUTES=false

# --- Firebase Admin (FCM, Nest): сервисный аккаунт ---
# Публичный конфиг для Firebase JS SDK в браузере — только на клиенте: `NEXT_PUBLIC_FIREBASE_*`
# (см. `client/.env.local.example` и корневой `.env` для `docker compose build client`). Здесь — только Admin JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- OAuth (Google); несколько client id через запятую ---
# Тот же id, что NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID на клиенте.
GOOGLE_OAUTH_CLIENT_ID=

# --- JWT (срок жизни; секрет при локальном старте — из корневого `.env` / JWT_SECRET) ---
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=604800

# --- Mail (режим задаёт NODE_ENV: prod → Resend, dev → SMTP) ---
# RESEND_API_KEY=
# MAIL_FROM=
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false

# --- Адреса / геокодинг ---
ADDRESS_PROVIDER_ORDER=nominatim,locationiq,geoapify,opencage
# ADDRESS_GEOCODE_TIMEOUT_MS=3500
LOCATIONIQ_API_KEY=
OPENCAGE_API_KEY=
GEOAPIFY_API_KEY=
# ADDRESS_NOMINATIM_USER_AGENT=
