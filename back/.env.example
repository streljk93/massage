# Локально — localhost. В Docker Compose (см. корневой docker-compose.yml) используется хост `postgres`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/services?schema=public"
PORT=3001
CLIENT_ORIGIN="http://localhost:3000"

# JWT для /v1/auth/* (access + refresh). В production обязательно задайте свой секрет.
JWT_SECRET=
# Опционально: время жизни токенов в секундах
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=604800
