# --- Core ---
# Локально: localhost. В docker-compose см. хост postgres.
# JWT_SECRET: в корневом .env.example / `npm run docker:env`; для локального Nest — продублируйте сюда.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/services?schema=public"
PORT=3001
CLIENT_ORIGIN="http://localhost:3000"

# --- HTTP throttle (@nestjs/throttler, in-memory) ---
# HTTP_THROTTLE_TTL_MS=60000
# HTTP_THROTTLE_LIMIT=400

# --- Storage (MinIO / S3) — см. Swagger /files ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=services-uploads
S3_REGION=us-east-1

# --- Redis (BullMQ: общее подключение для фоновых задач) ---
# Сервер ключей Redis; локально — docker compose `:6379`, внутри compose — имя сервиса redis. При появлении других доменных очередей подключение остаётся тем же — см. код Nest модулей.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Moderation: text (Ollama) ---
# Только база URL, без /api/chat. В compose см. проброс порта (:11435 с хоста).
# Пустой OLLAMA_BASE_URL — текст уходит без AI (ручная очередь по логике сервиса).
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=llama3.2
# OLLAMA_REQUEST_TIMEOUT_MS=90000

# --- Moderation: галерея (HTTP image-moderation: NudeNet + CLIP в docker-compose) ---
IMAGE_MODERATION_BASE_URL=http://127.0.0.1:8085
# Для доступа Nest изнутри контейнера модератора (не localhost контейнера):
# MODERATION_FILE_FETCH_ORIGIN=http://host.docker.internal:3001
# MODERATION_IMAGE_UNSAFE_THRESHOLD=0.5
# Порог pairwise CLIP (violence…weapon vs neutral); см. docker/nsfw-image-moderation/app.py
# MODERATION_CLIP_REVIEW_THRESHOLD=0.7
# Отключить второй этап CLIP (оставить только NudeNet): IMAGE_MODERATION_CLIP_ENABLED=false — в контейнере
# MODERATION_IMAGE_REQUEST_TIMEOUT_MS=60000

# Отложенная модерация профиля организации после онбординга: true — через BullMQ (нужны Redis-параметры выше); false — в том же HTTP-запросе без поднятия Bull в этом приложении для очередей модерации.
MODERATION_QUEUE_ENABLED=true

# --- Слоты в каталоге и на профиле ---
LISTING_CARD_PREVIEW_CALENDAR_DAYS=1
PROFILE_SLOT_PREVIEW_CALENDAR_DAYS=14

# --- Dev (/v1/dev/* вне production) ---
DISABLE_DEV_TEST_ROUTES=false

# --- Firebase Admin (push) ---
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- OAuth (Google); несколько client id через запятую ---
# Тот же id, что NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID на клиенте.
GOOGLE_OAUTH_CLIENT_ID=

# --- JWT (срок жизни; секрет см. блок Core выше — JWT_SECRET только в корневом .env / back/.env) ---
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=604800

# --- Mail (режим задаёт NODE_ENV: prod → Resend, dev → SMTP) ---
# RESEND_API_KEY=
# MAIL_FROM=
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false

# --- Адреса / геокодинг ---
ADDRESS_PROVIDER_ORDER=nominatim,locationiq,geoapify,opencage
# ADDRESS_GEOCODE_TIMEOUT_MS=3500
LOCATIONIQ_API_KEY=
OPENCAGE_API_KEY=
GEOAPIFY_API_KEY=
# ADDRESS_NOMINATIM_USER_AGENT=
