# Локально — localhost. В Docker Compose (см. корневой docker-compose.yml) используется хост `postgres`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/services?schema=public"
PORT=3001
CLIENT_ORIGIN="http://localhost:3000"

# Лимит HTTP-запросов с одного IP (скользящее окно, in-memory). См. @nestjs/throttler.
# HTTP_THROTTLE_TTL_MS=60000
# HTTP_THROTTLE_LIMIT=400

# MinIO / S3-совместимое хранилище (POST /v1/files/public | /private, см. Swagger).
# Локально: docker compose up minio -d  →  http://127.0.0.1:9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=services-uploads
S3_REGION=us-east-1

# Превью слотов на карточках каталога / главной / поиска (Asia/Ho_Chi_Minh, верхняя граница 90 — в коде).
# В DirectoryService слоты для списков и для профиля считаются в max(это значение, PROFILE_SLOT_PREVIEW_CALENDAR_DAYS) дней — совпадение сетки с deep link ?slotDay=&slotTime=.
LISTING_CARD_PREVIEW_CALENDAR_DAYS=1
# Сколько календарных дней слотов отдавать на странице профиля салона/мастера.
PROFILE_SLOT_PREVIEW_CALENDAR_DAYS=14

# Dev-only ручки под /v1/dev/* (смена статуса брони и т.п.): в production всегда 404.
# В dev по умолчанию включены; выключить все: DISABLE_DEV_TEST_ROUTES=true
DISABLE_DEV_TEST_ROUTES=false

# Firebase Admin (FCM): отправка web push. JSON сервисного аккаунта одной строкой
# (скачать: Firebase Console → Project settings → Service accounts → Generate new private key).
# Альтернатива: файл ключа и переменная окружения GOOGLE_APPLICATION_CREDENTIALS=/path/to.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JWT для /v1/auth/* (access + refresh). В production обязательно задайте свой секрет.
JWT_SECRET=
# Опционально: время жизни токенов в секундах
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=604800
