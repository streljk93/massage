# Шаблон для `back/.env`.
# В Docker `back` часть значений берёт из корневого `.env` через compose.
# Здесь оставлены только backend-специфичные и реально используемые настройки.

# ------------------------------------------------------------------------------
# 1) Обязательное для backend
# ------------------------------------------------------------------------------
# Секрет JWT обычно лежит в корневом `.env` (`JWT_SECRET`) и подтягивается автоматически.
# Для изолированного запуска back можно задать его здесь:
# JWT_SECRET=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/services?schema=public
CLIENT_ORIGIN=http://localhost:3000

# Демо-салоны/мастера при `prisma db seed` (по умолчанию выключено; для локальной витрины: true)
# SEED_DEMO_DATA=true

# Суперадмин платформы (создаётся/обновляется при старте приложения)
ADMIN_MASTER_NAME=Platform Admin
ADMIN_MASTER_EMAIL=
ADMIN_MASTER_PASSWORD=

# ------------------------------------------------------------------------------
# 2) Локальная инфраструктура для `cd back && npm run start:dev`
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=services-uploads
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 3) Moderation / AI
# ------------------------------------------------------------------------------
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=llama3.2

IMAGE_MODERATION_BASE_URL=http://127.0.0.1:8085
# MODERATION_FILE_FETCH_ORIGIN=http://host.docker.internal:3001
MODERATION_QUEUE_ENABLED=true

# ------------------------------------------------------------------------------
# 4) Mail (dev -> SMTP, prod -> Resend)
# ------------------------------------------------------------------------------
MAIL_FROM="Dev <dev@local.test>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false

# Только для production:
# RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 5) Optional integrations
# ------------------------------------------------------------------------------
# Firebase Admin JSON для push-уведомлений от backend
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# OAuth Google (можно несколько client id через запятую)
GOOGLE_OAUTH_CLIENT_ID=

# Geocoding API keys (если используются внешние провайдеры)
# ADDRESS_PROVIDER_ORDER=nominatim,locationiq,geoapify,opencage
# LOCATIONIQ_API_KEY=
# OPENCAGE_API_KEY=
# GEOAPIFY_API_KEY=

# ------------------------------------------------------------------------------
# 6) Лимиты записи / перенос (опционально)
# ------------------------------------------------------------------------------
# BOOKING_CLIENT_MAX_PENDING=5
# BOOKING_CLIENT_MAX_CREATES_PER_HOUR=10
# BOOKING_CLIENT_MAX_CREATES_PER_DAY=30
# Запрет переноса подтверждённой брони мастером, если до старта осталось меньше N минут (0 = выкл.)
# BOOKING_RESCHEDULE_FORBID_WITHIN_MINUTES_BEFORE_ORIGINAL_START=0
# Таймаут advisory/lock при создании/переносе в пересечении слота мастера (мс); при истечении — 503 BOOKING_BUSY_RETRY, клиент повторяет с тем же Idempotency-Key
# BOOKING_ADVISORY_LOCK_TIMEOUT_MS=2000
# Очередь BullMQ `booking-command`: при lock_timeout создание (обязателен Idempotency-Key) и перенос ставятся в фон; HTTP 202 BOOKING_QUEUED. Нужны Redis (REDIS_*) и этот флаг `true`.
# BOOKING_COMMAND_QUEUE_ENABLED=false

# ------------------------------------------------------------------------------
# Маркетплейс / поиск (Typesense, optional)
# ------------------------------------------------------------------------------
# TYPESENSE_HOST=127.0.0.1
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=
# TYPESENSE_MARKETPLACE_COLLECTION=marketplace_offerings_v1
# TYPESENSE_LISTING_EDGES_COLLECTION=marketplace_listing_edges_v1

# ------------------------------------------------------------------------------
# Интеграционные тесты Jest (`npm run test:integration` в `back/`)
# ------------------------------------------------------------------------------
# По умолчанию suite пропускается, если нет `DATABASE_URL` в окружении.
# Опционально: отдельная БД `BOOKING_INTEGRATION_DATABASE_URL`; конкретная бронь —
# `BOOKING_INTEGRATION_BOOKING_ID` (uuid с непустым журналом событий).
