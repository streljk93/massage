// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

/// Статус бронирования (жизненный цикл записи к специалисту).
enum BookingStatus {
  pending
  expired
  reject_by_master
  reject_by_client
  confirmed
  canceled_by_master
  canceled_by_client
  no_show_by_client
  no_show_by_master
  in_progress
  done
}

/// Локализованные подписи статусов бронирования для API (веб, мобильные клиенты).
model BookingStatusLocale {
  status BookingStatus
  locale String
  label  String

  @@id([status, locale])
  @@index([locale])
}

/// Рекламный баннер: внутренний (продукт) или внешний партнёр.
enum AdvertOwnerKind {
  internal
  external
}

/// Роль специалиста в организации (членство + права). Не путать с глобальной ролью User.
/// owner — владелец салона; admin — управление без владения; specialist — обычный мастер.
enum OrganizationMembershipRole {
  owner
  admin
  specialist
}

/// Глобальная платформенная роль учётной записи (не роль мастера в организации).
enum PlatformRole {
  standard
  master
}

/// Заявка мастера на работу в существующем салоне (онбординг / смена места).
enum SpecialistWorkplaceJoinRequestStatus {
  pending
  withdrawn
  accepted
  rejected
  /// Салон запретил этому мастеру новые заявки в эту организацию.
  blocked
}

/// Цель избранного клиента: салон или мастер (витрина).
enum FavoriteTargetKind {
  organization
  specialist
}

/// Провайдер социального / OIDC-входа (клиентское приложение).
enum OAuthProvider {
  google
}

/// Доступность контента во витрине после предмодерации (AI или ручное решение).
enum PublicationModerationStatus {
  /// Разрешено к показу (AI одобрил или модератор).
  approved
  /// На ручной проверке или ожидание проверки; из витрины скрыто.
  pending_review
  /// Отклонено модератором.
  rejected
}

enum OrganizationProfileRevisionStatus {
  pending_review
  published
  rejected
  superseded
}

/// Область привязки галереи (расширяется: главная, новости и т.д.).
enum GalleryOwnerKind {
  organization
  organization_profile_revision
}

/// Тип модерируемой сущности; `subjectId` — id строки (`organization_profile` = `OrganizationProfileRevision.id`; `specialist_profile` = `Specialist.id`).
/// Новые виды добавляются сюда — без новых столбцов в таблице кейсов.
enum ContentModerationCaseKind {
  organization_profile
  organization_review
  specialist_review
  specialist_profile
  user_display_name
}

enum ContentModerationCaseStatus {
  open
  resolved_approved
  resolved_rejected
}

// --- Core user ---

/// Учётная запись пользователя. Пароль только для email-входа; OAuth — `UserOAuthAccount`.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  /// Отображаемое имя (редактируемое пользователем).
  name         String
  /// Последнее имя, допущенное ко витрине; пока имя «на модерации», в каталоге показываем это (или синхрон с `name` при отсутствии правок).
  catalogListedName String?
  /// Argon2/bcrypt-хэш; null если пользователь только через OAuth (будущее).
  passwordHash String?
  /// Телефон (редактируемый профиль).
  phone        String?
  /// URL аватара.
  avatarUrl    String?
  /// Предпочитаемая локаль UI (например vi, en, ru).
  locale       String?
  /// Push: напоминание клиенту о визите за N минут до `startsAt` (только `bookingReminderEnabled`).
  bookingReminderEnabled     Boolean @default(true)
  /// Допустимые значения: 15, 30, 60 (валидация в API).
  bookingReminderLeadMinutes Int     @default(60)
  /// Регистрация по паролю: дата проставляется при создании `User` (после OTP). Null — для будущих сценариев (напр. OAuth).
  emailVerifiedAt            DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  specialistProfile    Specialist?
  clientBookings    Booking[]              @relation("ClientBookings")
  bookingChanges    BookingStatusHistory[]
  orgReviews        OrganizationReview[]
  specialistReviews SpecialistReview[]
  ownedOrganizations Organization[]        @relation("OrganizationOwner")
  fcmTokens            UserFcmToken[]
  favorites            UserFavorite[]
  behaviorEvents       UserBehaviorEvent[]
  preferenceProfile    UserPreferenceProfile?
  oAuthAccounts        UserOAuthAccount[]

  /// Отображаемое имя: после смены проходит предмодерацию; до `approved` скрыто во витрине (мастер).
  nameModerationStatus PublicationModerationStatus @default(approved)
  /// Ручная модерация контента (внутренний флаг; не путать с ролью в организации).
  isContentModerator   Boolean                    @default(false)
  /// Суперадмин: полный доступ к админ-панели; создаётся/обновляется из `ADMIN_MASTER_*` в `back/.env` при старте API.
  platformRole         PlatformRole               @default(standard)

  contentModerationCasesResolved ContentModerationCase[] @relation("ContentModerationResolvedBy")
}

/// Привязка внешнего аккаунта (Google) к `User`.
model UserOAuthAccount {
  id                  String         @id @default(uuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            OAuthProvider
  /// `sub` в Google id_token.
  providerAccountId  String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Регистрация по email+паролю до подтверждения: `User` создаётся только после верного OTP.
model PendingRegistration {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

/// FCM (web) registration token: одно устройство/браузер — одна запись, токен уникален глобально.
model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FCM device token; при смене владельца (другой логин с того же устройства) — upsert.
  token     String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Избранные салоны и мастера пользователя-клиента.
model UserFavorite {
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKind FavoriteTargetKind
  targetId   String
  createdAt  DateTime            @default(now())

  @@id([userId, targetKind, targetId])
  @@index([userId])
}

/// События витрины для персонализации. `userId` null — гость; `sessionId` — анонимно, без PII.
model UserBehaviorEvent {
  id         String  @id @default(uuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Браузерная сессия, если нет `userId` (или для корреляции).
  sessionId  String?
  /// Напр. search_view, specialist_view, organization_view, search_apply_filters.
  eventType  String
  entityType String?
  entityId   String?
  /// Slugs, id фильтра, majorSlug; без ввода пользователя (политика приватности).
  metadata   Json    @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
}

/// Агрегат предпочтений (портрет) для «для вас»; пересчёт cron’ом и при первом запросе.
model UserPreferenceProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Схема `profile` JSON (см. `PreferenceProfileV1` в коде).
  version    Int      @default(1)
  profile    Json
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Большая категория услуг (вертикаль): массаж, в будущем — бьюти, стрижки и т.д.
model MajorServiceCategory {
  id        String  @id @default(uuid())
  /// Каноническое / fallback-имя (например en), если нет строки в `locales` для запрошенной локали.
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories ServiceCategory[]
  locales    MajorServiceCategoryLocale[]
}

/// Локализованное имя большой категории (en / vi / ru; позже de и др. — новые строки без смены схемы).
model MajorServiceCategoryLocale {
  id                     String               @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Cascade)

  /// BCP-47 подмножество: en, vi, ru, …
  locale String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([majorServiceCategoryId, locale])
  @@index([locale])
}

/// Категория внутри большой (например «массаж стоп», «расслабляющий»): полное имя, короткое, slug.
model ServiceCategory {
  id                   String @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Restrict)

  /// Канонические / fallback `name`, `shortName`, `description` (часто en).
  name        String
  shortName   String
  slug        String
  /// Описание для SEO/карточек (опционально).
  description String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  services Service[]
  locales  ServiceCategoryLocale[]

  specialistTags    SpecialistServiceCategory[]
  organizationTags OrganizationServiceCategory[]
  revisionTags     OrganizationProfileRevisionServiceCategory[]

  @@unique([majorServiceCategoryId, slug])
  @@index([majorServiceCategoryId])
}

/// Локализованные `name`, `shortName`, опционально `description` для подкатегории каталога.
model ServiceCategoryLocale {
  id                String          @id @default(uuid())
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  shortName   String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceCategoryId, locale])
  @@index([locale])
}

/// Физический адрес (геокод, витрина); ссылка с `Organization.addressId`.
model Address {
  id               String   @id @default(uuid())
  /// Строка адреса для отображения.
  addressLine      String?
  /// Город / населённый пункт.
  city             String?
  latitude         Float?
  longitude        Float?
  /// Напр. `google_places` или `manual` при вводе без справочника.
  sourceProvider   String?
  /// Внешний id места (place id) при `sourceProvider` из справочника.
  sourceReference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organizations Organization[]

  @@index([city])
  @@index([latitude, longitude])
}

/// Организация (салон, парикмахерская и т.д.); в UI часто «салон массажа».
model Organization {
  id   String @id @default(uuid())
  /// Каноническое / fallback название и описание.
  name String
  slug String @unique

  /// Владелец организации в системе (пользователь).
  ownerUserId String?
  ownerUser   User?   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  /// Адрес салона: отдельная сущность.
  addressId String?
  address   Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  description     String?
  phone           String?
  email           String?
  website         String?
  yearsInBusiness Int?

  /// Минуты с полуночи (Asia/Ho_Chi_Minh) — начало приёма; сетка 30 мин (например 480=8:00, 540=9:00, 600=10:00).
  listingWorkdayStartMinute Int @default(480)
  /// Окончание приёма (например 1260=21:00, 1320=22:00, 1380=23:00; последний старт = end − 30 мин).
  listingWorkdayEndMinute   Int @default(1320)

  /// Денормализованные агрегаты (обновляются при отзывах / фоново).
  ratingAverage Float @default(0)
  reviewsCount  Int   @default(0)

  /// Сколько минут ждать подтверждения записи мастером/салоном (pending → иначе авто-expired). По умолчанию 15.
  bookingConfirmationGraceMinutes Int @default(15)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Витрина салона: до AI/ручного одобрения не показывается в каталоге.
  publicationModerationStatus PublicationModerationStatus @default(approved)
  /// Снимок витринного профиля, уже опубликованный гостям; промодерированный черновик лежит в ревизиях со статусом pending/rejected.
  publishedProfileRevisionId String? @unique
  publishedProfileRevision   OrganizationProfileRevision? @relation("OrganizationPublishedRevision", fields: [publishedProfileRevisionId], references: [id], onDelete: SetNull)

  reviews              OrganizationReview[]
  services             Service[]
  bookings             Booking[]
  specialistEmployments SpecialistOrganizationEmployment[]
  /// Мастера, у которых эта организация выбрана как текущее место приёма.
  specialistsActiveWorkplace Specialist[] @relation("SpecialistActiveOrganization")
  locales               OrganizationLocale[]
  serviceCategories     OrganizationServiceCategory[]
  workplaceJoinRequests SpecialistWorkplaceJoinRequest[]
  profileRevisions OrganizationProfileRevision[] @relation("OrganizationProfileRevisions")

  @@index([ownerUserId])
  @@index([addressId])
}

/// Черновик/история витринного профиля организации до promote в строку `Organization`
/// (локали витрины + адрес и т.п. копируются из снимка ревизии на этапе промоута).
model OrganizationProfileRevision {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrganizationProfileRevisions", fields: [organizationId], references: [id], onDelete: Cascade)

  status OrganizationProfileRevisionStatus @default(pending_review)

  /// Локаль UI при подаче — для восстановления строк `OrganizationLocale` без отдельных переводов ревизии.
  catalogLocale String

  /// Копия текстов ручного ввода (один язык, без таблицы `*RevisionLocale`).
  name        String
  description String?
  phone       String?
  email       String?
  website     String?
  yearsInBusiness Int?

  /// Снимок адреса на момент подачи (как после `resolveToCanonical`; промоут обновляет `Address` организации).
  addressLine            String?
  city                   String?
  latitude               Float?
  longitude              Float?
  addressSourceProvider   String?
  addressSourceReference  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedOnOrganization Organization[] @relation("OrganizationPublishedRevision")
  serviceCategories     OrganizationProfileRevisionServiceCategory[]

  @@index([organizationId])
  @@index([organizationId, status])
}

/// Подкатегории витрины, привязанные к черновику ревизии (до одобрения — копируются в `OrganizationServiceCategory`).
model OrganizationProfileRevisionServiceCategory {
  revisionId        String
  serviceCategoryId String

  revision        OrganizationProfileRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory            @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@id([revisionId, serviceCategoryId])
  @@index([serviceCategoryId])
}

/// Тип элемента галереи (видео — на будущее).
enum GalleryMediaKind {
  image
  video
}

/// Переиспользуемая галерея медиа; владелец задаётся парой `ownerKind` + `ownerId`.
model Gallery {
  id        String           @id @default(uuid())
  ownerKind GalleryOwnerKind
  ownerId   String
  createdAt DateTime         @default(now())
  items     GalleryItem[]

  @@unique([ownerKind, ownerId])
  @@index([ownerId])
}

/// Элемент галереи; порядок отображения — `sortOrder` (меньше = раньше в слайдере / первая «обложка» для витрины организации).
model GalleryItem {
  id        String   @id @default(uuid())
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  kind      GalleryMediaKind @default(image)
  sortOrder Int              @default(0)

  createdAt DateTime @default(now())

  @@index([galleryId, sortOrder])
}

/// Локализованные название и описание организации (витрина / SEO на разных языках).
model OrganizationLocale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, locale])
  @@index([locale])
}

/// Выбранные подкатегории каталога у организации (витрина / фильтры).
model OrganizationServiceCategory {
  organizationId    String
  serviceCategoryId String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([organizationId, serviceCategoryId])
  @@index([serviceCategoryId])
}

/// Отзыв о организации.
model OrganizationReview {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  /// Привязка к завершённому бронированию (верифицированный отзыв), опционально.
  bookingId String?  @unique
  booking   Booking? @relation("OrganizationReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  rating Int
  /// Текст после одобрения; виден во витрине гостям.
  publishedComment String? @db.Text
  /// Не опубликованный черновик (на проверке); сам автор может видеть в API отдельно.
  pendingCommentDraft String? @db.Text

  /// Публикация текста отзыва во витрине (`approved` только после AI/ручного решения при необходимости).
  publicationModerationStatus PublicationModerationStatus @default(approved)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([authorUserId])
}

/// Профиль специалиста (мастер), 1:1 с пользователем со «статусом специалиста».
model Specialist {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  experienceYears Int?

  /// Имя мастера на витрине (каталог, карточка записи). Не путать с `User.name` (личный клиентский профиль).
  listingName                   String?
  ratingAverage Float @default(0)
  reviewsCount  Int   @default(0)
  imageUrl      String?
  imageAlt      String?

  /// Публикация полей профиля для каталога: одобрено / на модерации; при правках после одобрения гости видят снимок в `catalogListed*`.
  profilePublicationModerationStatus PublicationModerationStatus @default(approved)
  catalogListedBio               String?
  catalogListedListingName       String?
  catalogListedImageUrl          String?

  /// Параметры, специфичные для вертикали «массаж» (сила нажима и т.д.); другие крупные категории — отдельные 1:1.
  massageProfile SpecialistMassageProfile?

  /// Текущее место приёма (адрес и гео для витрины берутся от этой организации).
  activeOrganizationId String?
  activeOrganization   Organization? @relation("SpecialistActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  /// Показывать в клиентском каталоге/поиске как мастера (запись к человеку). Не путать с ролью в организации: владелец без приёма — false.
  listedInDirectory Boolean @default(false)

  /// Завершён сценарий первичной настройки (финальный экран); витрина — только вместе с `activeOrganizationId` и флагом listed.
  onboardingCompletedAt DateTime?

  /// Записи сразу в `confirmed` (без ожидания ручного подтверждения мастером / без pending).
  autoConfirmBookings Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employments         SpecialistOrganizationEmployment[]
  workplaceJoinRequests SpecialistWorkplaceJoinRequest[]
  services            Service[]
  bookings            Booking[]
  reviews             SpecialistReview[]
  serviceCategories   SpecialistServiceCategory[]

  @@index([activeOrganizationId])
}

/// Профиль мастера в вертикали «массаж» (онбординг / витрина), чтобы не тащить отраслевые поля в `Specialist`.
model SpecialistMassageProfile {
  specialistId String     @id
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  /// Сила нажима (шкала 1–5); null — ещё не задано в онбординге.
  pressureLevel Int?
  /// Подстраивать силу под пожелания клиента.
  pressureAdaptsToClient Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Выбранные подкатегории каталога у специалиста.
model SpecialistServiceCategory {
  specialistId      String
  serviceCategoryId String
  specialist        Specialist      @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([specialistId, serviceCategoryId])
  @@index([serviceCategoryId])
}

/// Период работы специалиста в организации (история смены салонов).
model SpecialistOrganizationEmployment {
  id             String @id @default(uuid())
  specialistId   String
  specialist     Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Права в рамках этой организации (см. `Organization.ownerUserId` для владельца-сущности).
  role OrganizationMembershipRole @default(specialist)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialistId])
  @@index([organizationId])
  @@index([isActive])
  @@index([role])
}

/// Заявка специалиста на приём в организацию (без автоматического членства).
model SpecialistWorkplaceJoinRequest {
  id             String @id @default(uuid())
  specialistId   String
  organizationId String
  status         SpecialistWorkplaceJoinRequestStatus @default(pending)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  specialist   Specialist   @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([specialistId, organizationId])
  @@index([specialistId, status])
  @@index([organizationId, status])
}

/// Услуга в каталоге организации или личная услуга мастера (`organizationId` = null).
model Service {
  id             String @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id], onDelete: SetNull)

  /// Стабильный ключ в пределах организации / личного каталога; отображаемое имя — у `ServiceCategory`.
  slug        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  priceOptions ServicePriceOption[]
  bookings     Booking[]

  /// Уникальность `(organizationId, slug)` и `(specialistId, slug)` при `organizationId IS NULL` задаётся частичными индексами в SQL-миграции.
  @@index([organizationId, slug])
  @@index([specialistId, slug])
  @@index([categoryId])
  @@index([specialistId])
}

/// Варианты длительности и цены для услуги.
model ServicePriceOption {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  durationMinutes Int
  /// Сумма в минимальных единицах валюты (например донги VND целиком).
  priceAmount     Int
  currency        String @default("VND")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, durationMinutes])
  @@index([serviceId])
}

/// Отзыв о специалисте.
model SpecialistReview {
  id           String     @id @default(uuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  bookingId String?  @unique
  booking   Booking? @relation("SpecialistReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  rating Int
  publishedComment String? @db.Text
  pendingCommentDraft String? @db.Text

  publicationModerationStatus PublicationModerationStatus @default(approved)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([specialistId])
  @@index([authorUserId])
}

/// Элемент очереди ручной модерации (контент не прошёл AI или недоступен AI).
/// Привязка: одна строка ↔ одна модерируемая сущность (`kind` + `subjectId`), без отдельного столбца на каждый тип.
/// При жёстком удалении сущности из приложения удаляйте кейсы здесь же (до переноса раньше срабатывал ON DELETE FK).
model ContentModerationCase {
  id     String                       @id @default(uuid())
  kind   ContentModerationCaseKind
  /// Id модерируемой сущности (смысл задаётся `kind`, см. enum).
  subjectId String
  status ContentModerationCaseStatus @default(open)

  aiSummary String? @db.Text

  moderatorUserId String?
  moderatorUser   User?   @relation("ContentModerationResolvedBy", fields: [moderatorUserId], references: [id], onDelete: SetNull)

  moderatorReason String? @db.Text

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, subjectId])
  @@index([status, createdAt])
}

/// Бронирование (запись к специалисту); текущее состояние в `status`, история — в BookingStatusHistory.
model Booking {
  id String @id @default(uuid())

  clientUserId String
  client       User   @relation("ClientBookings", fields: [clientUserId], references: [id], onDelete: Cascade)

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// Локализованный `shortName` подкатегории на момент записи.
  categoryShortNameSnapshot String?
  durationMinutes     Int
  priceAmountSnapshot Int?
  currencySnapshot    String? @default("VND")

  startsAt DateTime
  endsAt   DateTime

  status BookingStatus @default(pending)

  /// Дедлайн авто-истечения для pending (не подтвердили за N минут).
  pendingExpiresAt DateTime?

  /// Причина отмены/истечения: код (например `pending_confirmation_timeout`) или канонический английский авто-текст.
  cancelReason String?
  /// Дополнительный комментарий при отмене (например пояснение от мастера); системные отмены часто без текста.
  cancellationComment String?

  /// Когда ушло push-напоминание клиенту о визите (заданный lead); null = ещё не отправляли.
  clientReminderSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  statusHistory      BookingStatusHistory[]
  organizationReview OrganizationReview? @relation("OrganizationReviewBooking")
  specialistReview   SpecialistReview?   @relation("SpecialistReviewBooking")

  @@index([clientUserId])
  @@index([specialistId])
  @@index([organizationId])
  @@index([startsAt])
  @@index([status])
  @@index([status, pendingExpiresAt])
}

/// История переходов статусов бронирования.
model BookingStatusHistory {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus BookingStatus?
  toStatus   BookingStatus

  /// Кто инициировал смену (клиент, специалист, система — userId может быть null для cron).
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

/// Рекламное объявление / баннер по слоту показа (`placement`), с мультиязычными текстами.
model Advertisement {
  id        String @id @default(uuid())
  /// Слот: `home_promo`, `search_banner`, … — выборка по query `placement`.
  placement String
  ownerKind AdvertOwnerKind @default(internal)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Канонические тексты (fallback, обычно en).
  title    String
  subtitle String
  ctaLabel String

  imageUrl  String
  targetUrl String?

  /// Стабильный ключ для сидов (upsert); null у записей из админки / API.
  refKey String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locales AdvertisementLocale[]

  @@index([placement, isActive, deletedAt, sortOrder])
}

model AdvertisementLocale {
  id              String        @id @default(uuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  locale String
  title  String
  subtitle String
  ctaLabel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advertisementId, locale])
  @@index([locale])
}
