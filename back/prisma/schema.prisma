// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

/// Статус бронирования (жизненный цикл записи к специалисту).
enum BookingStatus {
  pending
  expired
  reject_by_master
  reject_by_client
  confirmed
  canceled_by_master
  canceled_by_client
  no_show_by_client
  no_show_by_master
  in_progress
  done
}

/// Рекламный баннер: внутренний (продукт) или внешний партнёр.
enum AdvertOwnerKind {
  internal
  external
}

// --- Core user ---

/// Учётная запись пользователя. Пароль только для email-входа; OAuth — отдельная связка позже.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  /// Отображаемое имя (профиль).
  name         String
  /// Argon2/bcrypt-хэш; null если пользователь только через OAuth (будущее).
  passwordHash String?
  /// Телефон (редактируемый профиль).
  phone        String?
  /// URL аватара.
  avatarUrl    String?
  /// Предпочитаемая локаль UI (например vi, en, ru).
  locale       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  specialistProfile Specialist?
  clientBookings    Booking[]              @relation("ClientBookings")
  bookingChanges    BookingStatusHistory[]
  orgReviews        OrganizationReview[]
  specialistReviews SpecialistReview[]
  ownedOrganizations Organization[]        @relation("OrganizationOwner")
}

/// Большая категория услуг (вертикаль): массаж, в будущем — бьюти, стрижки и т.д.
model MajorServiceCategory {
  id        String  @id @default(uuid())
  /// Каноническое / fallback-имя (например en), если нет строки в `locales` для запрошенной локали.
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories ServiceCategory[]
  locales    MajorServiceCategoryLocale[]
}

/// Локализованное имя большой категории (en / vi / ru; позже de и др. — новые строки без смены схемы).
model MajorServiceCategoryLocale {
  id                     String               @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Cascade)

  /// BCP-47 подмножество: en, vi, ru, …
  locale String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([majorServiceCategoryId, locale])
  @@index([locale])
}

/// Категория внутри большой (например «массаж стоп», «расслабляющий»): полное имя, короткое, slug.
model ServiceCategory {
  id                   String @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Restrict)

  /// Канонические / fallback `name`, `shortName`, `description` (часто en).
  name        String
  shortName   String
  slug        String
  /// Описание для SEO/карточек (опционально).
  description String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  services Service[]
  locales  ServiceCategoryLocale[]

  @@unique([majorServiceCategoryId, slug])
  @@index([majorServiceCategoryId])
}

/// Локализованные `name`, `shortName`, опционально `description` для подкатегории каталога.
model ServiceCategoryLocale {
  id                String          @id @default(uuid())
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  shortName   String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceCategoryId, locale])
  @@index([locale])
}

/// Организация (салон, парикмахерская и т.д.); в UI часто «салон массажа».
model Organization {
  id   String @id @default(uuid())
  /// Каноническое / fallback название и описание.
  name String
  slug String @unique

  /// Владелец организации в системе (пользователь).
  ownerUserId String?
  ownerUser   User?   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  description     String?
  phone           String?
  email           String?
  website         String?
  addressLine     String?
  city            String?
  latitude        Float?
  longitude       Float?
  imageUrl        String?
  imageAlt        String?
  yearsInBusiness Int?

  /// Денормализованные агрегаты (обновляются при отзывах / фоново).
  ratingAverage Float @default(0)
  reviewsCount  Int   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reviews              OrganizationReview[]
  services             Service[]
  bookings             Booking[]
  specialistEmployments SpecialistOrganizationEmployment[]
  locales               OrganizationLocale[]

  @@index([ownerUserId])
  @@index([city])
}

/// Локализованные название и описание организации (витрина / SEO на разных языках).
model OrganizationLocale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, locale])
  @@index([locale])
}

/// Отзыв о организации.
model OrganizationReview {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  /// Привязка к завершённому бронированию (верифицированный отзыв), опционально.
  bookingId String?  @unique
  booking   Booking? @relation("OrganizationReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  rating  Int
  comment String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([authorUserId])
}

/// Профиль специалиста (мастер), 1:1 с пользователем со «статусом специалиста».
model Specialist {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  /// Строка специализаций для карточки (аналог specialtiesLine в UI).
  specialtiesLine String?
  experienceYears Int?
  /// Подпись вида «1.5k +» для демо/UI.
  clientsLabel    String?

  ratingAverage Float @default(0)
  reviewsCount  Int   @default(0)
  imageUrl      String?
  imageAlt      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employments SpecialistOrganizationEmployment[]
  services    Service[]
  bookings    Booking[]
  reviews     SpecialistReview[]
}

/// Период работы специалиста в организации (история смены салонов).
model SpecialistOrganizationEmployment {
  id             String @id @default(uuid())
  specialistId   String
  specialist     Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialistId])
  @@index([organizationId])
  @@index([isActive])
}

/// Услуга в каталоге организации (и привязка к категории).
model Service {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id], onDelete: SetNull)

  name        String
  slug        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  priceOptions ServicePriceOption[]
  bookings     Booking[]
  locales      ServiceLocale[]

  @@unique([organizationId, slug])
  @@index([categoryId])
  @@index([specialistId])
}

/// Локализованные название и описание услуги в каталоге организации.
model ServiceLocale {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, locale])
  @@index([locale])
}

/// Варианты длительности и цены для услуги.
model ServicePriceOption {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  durationMinutes Int
  /// Сумма в минимальных единицах валюты (например донги VND целиком).
  priceAmount     Int
  currency        String @default("VND")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, durationMinutes])
  @@index([serviceId])
}

/// Отзыв о специалисте.
model SpecialistReview {
  id           String     @id @default(uuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  bookingId String?  @unique
  booking   Booking? @relation("SpecialistReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  rating  Int
  comment String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([specialistId])
  @@index([authorUserId])
}

/// Бронирование (запись к специалисту); текущее состояние в `status`, история — в BookingStatusHistory.
model Booking {
  id String @id @default(uuid())

  clientUserId String
  client       User   @relation("ClientBookings", fields: [clientUserId], references: [id], onDelete: Cascade)

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// Снимок на момент записи (если услугу удалили из каталога).
  serviceNameSnapshot String?
  durationMinutes     Int
  priceAmountSnapshot Int?
  currencySnapshot    String? @default("VND")

  startsAt DateTime
  endsAt   DateTime

  status BookingStatus @default(pending)

  /// Дедлайн авто-истечения для pending (не подтвердили за N минут).
  pendingExpiresAt DateTime?

  cancelReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  statusHistory      BookingStatusHistory[]
  organizationReview OrganizationReview? @relation("OrganizationReviewBooking")
  specialistReview   SpecialistReview?   @relation("SpecialistReviewBooking")

  @@index([clientUserId])
  @@index([specialistId])
  @@index([organizationId])
  @@index([startsAt])
  @@index([status])
}

/// История переходов статусов бронирования.
model BookingStatusHistory {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus BookingStatus?
  toStatus   BookingStatus

  /// Кто инициировал смену (клиент, специалист, система — userId может быть null для cron).
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

/// Рекламное объявление / баннер по слоту показа (`placement`), с мультиязычными текстами.
model Advertisement {
  id        String @id @default(uuid())
  /// Слот: `home_promo`, `search_banner`, … — выборка по query `placement`.
  placement String
  ownerKind AdvertOwnerKind @default(internal)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Канонические тексты (fallback, обычно en).
  title    String
  subtitle String
  ctaLabel String

  imageUrl  String
  targetUrl String?

  /// Стабильный ключ для сидов (upsert); null у записей из админки / API.
  refKey String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locales AdvertisementLocale[]

  @@index([placement, isActive, deletedAt, sortOrder])
}

model AdvertisementLocale {
  id              String        @id @default(uuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  locale String
  title  String
  subtitle String
  ctaLabel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advertisementId, locale])
  @@index([locale])
}
