// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

/// Статус бронирования (жизненный цикл записи к специалисту).
enum BookingStatus {
  pending
  expired
  reject_by_master
  reject_by_client
  confirmed
  canceled_by_master
  canceled_by_client
  no_show_by_client
  no_show_by_master
  in_progress
  done
}

/// Событие жизненного цикла бронирования (append-only лог источника правды перед проекцией на строку Booking).
enum BookingEventType {
  created
  confirmed
  rejected
  canceled
  no_show
  completed
  started
  expired
  rescheduled
}

/// Актор события в журнале брони (BI / история; не глобальная роль User).
enum BookingActorKind {
  client
  specialist
  staff
  system
}

/// Тип ресурса календаря организации: сейчас мастер, позже кабинеты и оборудование.
enum CalendarResourceType {
  specialist
  room
  equipment
}

/// Core-тип календарного события. Поведение живёт в отдельных use case, не в enum-ветках сущности.
enum CalendarEventType {
  booking
  block
}

/// Причина служебного блока календаря.
enum CalendarBlockReason {
  break
  vacation
  manual
}

/// Статус календарного события для занятости ресурса.
enum CalendarEventStatus {
  pending
  confirmed
  in_progress
  cancelled
}

/// Недельные правила доступности: рабочее окно или регулярный перерыв.
enum AvailabilityRuleType {
  working
  break
}

/// Разовое переопределение доступности на дату.
enum AvailabilityOverrideType {
  off
  extra
}

/// Локализованные подписи статусов бронирования для API (веб, мобильные клиенты).
model BookingStatusLocale {
  status BookingStatus
  locale String
  label  String

  @@id([status, locale])
  @@index([locale])
}

/// Рекламный баннер: внутренний (продукт) или внешний партнёр.
enum AdvertOwnerKind {
  internal
  external
}

/// Роль специалиста в организации (членство + права). Не путать с глобальной ролью User.
/// owner — владелец салона; admin — управление без владения; specialist — обычный мастер.
enum OrganizationMembershipRole {
  owner
  admin
  specialist
}

/// Глобальная платформенная роль учётной записи (не роль мастера в организации).
enum PlatformRole {
  standard
  master
}

/// Пол специалиста для клиентского фильтра.
enum SpecialistGender {
  male
  female
}

enum SpecialistWorkplaceJoinRequestStatus {
  pending
  withdrawn
  accepted
  rejected
  /// Салон запретил этому мастеру новые заявки в эту организацию.
  blocked
}

/// Публикация резюме специалиста в hiring-контуре.
enum SpecialistResumeVisibility {
  public
  private
}

/// Статус вакансии организации в hiring-контуре.
enum JobPostingStatus {
  draft
  open
  closed
}

/// Сторона, которая инициировала контакт найма.
enum HiringContactSource {
  application
}

/// Жизненный цикл контакта найма; активность для уникальности задаёт `HiringContact.isActive`.
enum HiringContactStatus {
  pending
  accepted
  rejected
  closed
}

enum JobApplicationStatus {
  pending
  accepted
  rejected
}

enum OrganizationSpecialistInvitationStatus {
  pending
  accepted
  rejected
  canceled
}

/// Тип организации: личная точка приёма или коммерческий салон / команда.
enum OrganizationType {
  solo
  business
}

/// Публикация коммерческого оффера точки (`OrganizationOffering`).
enum OfferingPublicationStatus {
  draft
  pending_review
  published
  archived
  rejected
  hidden
}

enum OfferingPriceOptionStatus {
  active
  hidden
  archived
}

/// Привязка мастера к офферам точки: исполнение, не канонический прайс.
enum SpecialistOfferingStatus {
  active
  paused
  hidden
  removed
}

/// Статус записи transactional outbox (§3.0.9).
enum TransactionalOutboxStatus {
  pending
  dispatched
  failed
}

/// Выбор режима работы при онбординге (до привязки к месту или параллельно черновику).
enum SpecialistWorkPattern {
  solo
  business
  employed_salon
}

/// Цель избранного клиента: салон или мастер (витрина).
enum FavoriteTargetKind {
  organization
  specialist
}

/// Провайдер социального / OIDC-входа (клиентское приложение).
enum OAuthProvider {
  google
}

/// Доступность контента во витрине после предмодерации (AI или ручное решение).
enum PublicationModerationStatus {
  /// Разрешено к показу (AI одобрил или модератор).
  approved
  /// На ручной проверке или ожидание проверки; из витрины скрыто.
  pending_review
  /// Отклонено модератором.
  rejected
}

enum OrganizationProfileRevisionStatus {
  pending_review
  published
  rejected
  superseded
}

enum SpecialistProfileRevisionStatus {
  pending_review
  published
  rejected
  superseded
}

/// Область привязки галереи (расширяется: главная, новости и т.д.).
enum GalleryOwnerKind {
  organization
  organization_profile_revision
}

/// Тип модерируемой сущности; `subjectId` — id строки (`organization_profile` = `OrganizationProfileRevision.id`; `specialist_profile` = `SpecialistProfileRevision.id`).
/// Новые виды добавляются сюда — без новых столбцов в таблице кейсов.
enum ContentModerationCaseKind {
  organization_profile
  organization_review
  specialist_review
  specialist_profile
  user_display_name
}

enum ContentModerationCaseStatus {
  open
  resolved_approved
  resolved_rejected
}

// --- Core user ---

/// Учётная запись пользователя. Пароль только для email-входа; OAuth — `UserOAuthAccount`.
model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  /// Отображаемое имя (редактируемое пользователем).
  name                       String
  /// Последнее имя, допущенное ко витрине; пока имя «на модерации», в каталоге показываем это (или синхрон с `name` при отсутствии правок).
  catalogListedName          String?
  /// Argon2/bcrypt-хэш; null если пользователь только через OAuth (будущее).
  passwordHash               String?
  /// Телефон (редактируемый профиль).
  phone                      String?
  /// URL аватара.
  avatarUrl                  String?
  /// Предпочитаемая локаль UI (например vi, en, ru).
  locale                     String?
  /// Push: напоминание клиенту о визите за N минут до `startsAt` (только `bookingReminderEnabled`).
  bookingReminderEnabled     Boolean   @default(true)
  /// Допустимые значения: 15, 30, 60 (валидация в API).
  bookingReminderLeadMinutes Int       @default(60)
  /// Регистрация по паролю: дата проставляется при создании `User` (после OTP). Null — для будущих сценариев (напр. OAuth).
  emailVerifiedAt            DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  specialistProfile            Specialist?
  clientBookings               Booking[]                          @relation("ClientBookings")
  bookingEventsActor           BookingEvent[]                     @relation("BookingEventActorUser")
  orgReviews                   OrganizationReview[]
  specialistReviews            SpecialistReview[]
  ownedOrganizations           Organization[]                     @relation("OrganizationOwner")
  fcmTokens                    UserFcmToken[]
  favorites                    UserFavorite[]
  behaviorEvents               UserBehaviorEvent[]
  preferenceProfile            UserPreferenceProfile?
  oAuthAccounts                UserOAuthAccount[]
  calendarEventsCreated        CalendarEvent[]                    @relation("CalendarEventCreatedBy")
  calendarEventAudits          CalendarEventAudit[]               @relation("CalendarEventAuditActor")
  jobPostingsCreated           JobPosting[]                       @relation("JobPostingCreatedBy")
  specialistResumesCreated     SpecialistResume[]                 @relation("SpecialistResumeCreatedBy")
  hiringContactsCreated        HiringContact[]                    @relation("HiringContactCreatedBy")
  jobApplicationsCreated       JobApplication[]                   @relation("JobApplicationCreatedBy")
  specialistInvitationsCreated OrganizationSpecialistInvitation[] @relation("OrganizationSpecialistInvitationCreatedBy")

  /// Отображаемое имя: после смены проходит предмодерацию; до `approved` скрыто во витрине (мастер).
  nameModerationStatus PublicationModerationStatus @default(approved)
  /// Ручная модерация контента (внутренний флаг; не путать с ролью в организации).
  isContentModerator   Boolean                     @default(false)
  /// Суперадмин: полный доступ к админ-панели; создаётся/обновляется из `ADMIN_MASTER_*` в `back/.env` при старте API.
  platformRole         PlatformRole                @default(standard)

  contentModerationCasesResolved ContentModerationCase[] @relation("ContentModerationResolvedBy")
  contentModerationCasesAssigned ContentModerationCase[] @relation("ContentModerationCaseAssignee")
  contentModerationCasesLocked   ContentModerationCase[] @relation("ContentModerationCaseLockHolder")
}

/// Привязка внешнего аккаунта (Google) к `User`.
model UserOAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  /// `sub` в Google id_token.
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Регистрация по email+паролю до подтверждения: `User` создаётся только после верного OTP.
model PendingRegistration {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

/// FCM (web) registration token: одно устройство/браузер — одна запись, токен уникален глобально.
model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FCM device token; при смене владельца (другой логин с того же устройства) — upsert.
  token     String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Избранные салоны и мастера пользователя-клиента.
model UserFavorite {
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKind FavoriteTargetKind
  targetId   String
  createdAt  DateTime           @default(now())

  @@id([userId, targetKind, targetId])
  @@index([userId])
}

/// События витрины для персонализации. `userId` null — гость; `sessionId` — анонимно, без PII.
model UserBehaviorEvent {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Браузерная сессия, если нет `userId` (или для корреляции).
  sessionId  String?
  /// Напр. search_view, specialist_view, organization_view, search_apply_filters.
  eventType  String
  entityType String?
  entityId   String?
  /// Slugs, id фильтра, majorSlug; без ввода пользователя (политика приватности).
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
}

/// Агрегат предпочтений (портрет) для «для вас»; пересчёт cron’ом и при первом запросе.
model UserPreferenceProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Схема `profile` JSON (см. `PreferenceProfileV1` в коде).
  version    Int      @default(1)
  profile    Json
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Большая категория услуг (вертикаль): массаж, в будущем — бьюти, стрижки и т.д.
model MajorServiceCategory {
  id        String  @id @default(uuid())
  /// Каноническое / fallback-имя (например en), если нет строки в `locales` для запрошенной локали.
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories                         ServiceCategory[]
  locales                            MajorServiceCategoryLocale[]
  /// Салоны, у которых эта большая категория выбрана как сфера деятельности (N:M).
  organizationMajorServiceCategories OrganizationMajorServiceCategory[]
  bodyZones                          BodyZone[]
  specialistOnboardingSelections     SpecialistOnboardingMajorServiceCategory[]
}

/// Локализованное имя большой категории (en / vi / ru; позже de и др. — новые строки без смены схемы).
model MajorServiceCategoryLocale {
  id                     String               @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Cascade)

  /// BCP-47 подмножество: en, vi, ru, …
  locale String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([majorServiceCategoryId, locale])
  @@index([locale])
}

/// Категория внутри большой (например «массаж стоп», «расслабляющий»): полное имя, короткое, slug.
model ServiceCategory {
  id                     String               @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Restrict)

  /// Канонические / fallback `name`, `shortName`, `description` (часто en).
  name        String
  shortName   String
  slug        String
  /// Описание для SEO/карточек (опционально).
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locales ServiceCategoryLocale[]

  specialistSkills      SpecialistSkill[]
  organizationTags      OrganizationServiceCategory[]
  revisionTags          OrganizationProfileRevisionServiceCategory[]
  organizationOfferings OrganizationOffering[]
  jobPostings           JobPosting[]

  @@unique([majorServiceCategoryId, slug])
  @@index([majorServiceCategoryId])
}

/// Локализованные `name`, `shortName`, опционально `description` для подкатегории каталога.
model ServiceCategoryLocale {
  id                String          @id @default(uuid())
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  shortName   String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceCategoryId, locale])
  @@index([locale])
}

/// Анатомическая зона для фильтрации/разметки услуг (MVP: вертикаль massage).
model BodyZone {
  id                     String               @id @default(uuid())
  majorServiceCategoryId String
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Restrict)
  slug                   String
  sortOrder              Int                  @default(0)
  isActive               Boolean              @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locales BodyZoneLocale[]

  @@unique([majorServiceCategoryId, slug])
  @@index([majorServiceCategoryId])
}

model BodyZoneLocale {
  id         String   @id @default(uuid())
  bodyZoneId String
  bodyZone   BodyZone @relation(fields: [bodyZoneId], references: [id], onDelete: Cascade)
  locale     String
  name       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bodyZoneId, locale])
  @@index([locale])
}

/// Физический адрес (геокод, витрина); ссылка с `Organization.addressId`.
model Address {
  id              String   @id @default(uuid())
  /// Строка адреса для отображения.
  addressLine     String?
  /// Город / населённый пункт.
  city            String?
  latitude        Float?
  longitude       Float?
  /// Напр. `google_places` или `manual` при вводе без справочника.
  sourceProvider  String?
  /// Внешний id места (place id) при `sourceProvider` из справочника.
  sourceReference String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizations Organization[]

  @@index([city])
  @@index([latitude, longitude])
}

/// Организация (салон, парикмахерская и т.д.); в UI часто «салон массажа».
model Organization {
  id   String @id @default(uuid())
  /// Каноническое / fallback название и описание.
  name String
  slug String @unique

  /// Владелец организации в системе (пользователь).
  ownerUserId String?
  ownerUser   User?   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  /// Адрес салона: отдельная сущность.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  description     String?
  phone           String?
  email           String?
  website         String?
  yearsInBusiness Int?

  /// Минуты с полуночи (Asia/Ho_Chi_Minh) — начало приёма; сетка 30 мин (например 480=8:00, 540=9:00, 600=10:00).
  listingWorkdayStartMinute Int    @default(480)
  /// Окончание приёма (например 1260=21:00, 1320=22:00, 1380=23:00; последний старт = end − 30 мин).
  listingWorkdayEndMinute   Int    @default(1320)
  /// IANA timezone, в которой задаются правила доступности и отображается календарь организации.
  timeZone                  String @default("Asia/Ho_Chi_Minh")

  /// Денормализованные агрегаты (обновляются при отзывах / фоново).
  ratingAverage Float @default(0)
  reviewsCount  Int   @default(0)

  /// solo — мастер на себя; business — салон с командой и т.д.
  organizationType OrganizationType @default(business)

  /// Сколько минут ждать подтверждения записи мастером/салоном (pending → иначе авто-expired). По умолчанию 15.
  bookingConfirmationGraceMinutes Int @default(15)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Витрина салона: до AI/ручного одобрения не показывается в каталоге.
  publicationModerationStatus PublicationModerationStatus  @default(approved)
  /// Снимок витринного профиля, уже опубликованный гостям; промодерированный черновик лежит в ревизиях со статусом pending/rejected.
  publishedProfileRevisionId  String?                      @unique
  publishedProfileRevision    OrganizationProfileRevision? @relation("OrganizationPublishedRevision", fields: [publishedProfileRevisionId], references: [id], onDelete: SetNull)

  reviews                    OrganizationReview[]
  bookings                   Booking[]
  specialistEmployments      SpecialistOrganizationEmployment[]
  /// Мастера, у которых эта организация выбрана как текущее место приёма.
  specialistsActiveWorkplace Specialist[]                       @relation("SpecialistActiveOrganization")
  locales                    OrganizationLocale[]
  serviceCategories          OrganizationServiceCategory[]
  /// Сферы деятельности: большие категории каталога, доступные для организации (выбор владельца).
  majorServiceCategories     OrganizationMajorServiceCategory[]
  workplaceJoinRequests      SpecialistWorkplaceJoinRequest[]
  profileRevisions           OrganizationProfileRevision[]      @relation("OrganizationProfileRevisions")
  offerings                  OrganizationOffering[]
  calendarResources          CalendarResource[]
  calendarEvents             CalendarEvent[]
  jobPostings                JobPosting[]
  hiringContacts             HiringContact[]
  specialistInvitations      OrganizationSpecialistInvitation[]

  @@index([ownerUserId])
  @@index([addressId])
}

/// Связь организации с большими категориями каталога (сферы деятельности), без «основной» категории — только N:M.
model OrganizationMajorServiceCategory {
  organizationId         String
  majorServiceCategoryId String
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([organizationId, majorServiceCategoryId])
  @@index([majorServiceCategoryId])
}

/// Черновик/история витринного профиля организации до promote в строку `Organization`
/// (локали витрины + адрес и т.п. копируются из снимка ревизии на этапе промоута).
model OrganizationProfileRevision {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrganizationProfileRevisions", fields: [organizationId], references: [id], onDelete: Cascade)

  status OrganizationProfileRevisionStatus @default(pending_review)

  /// Локаль UI при подаче — для восстановления строк `OrganizationLocale` без отдельных переводов ревизии.
  catalogLocale String

  /// Копия текстов ручного ввода (один язык, без таблицы `*RevisionLocale`).
  name            String
  description     String?
  phone           String?
  email           String?
  website         String?
  yearsInBusiness Int?

  /// Снимок адреса на момент подачи (как после `resolveToCanonical`; промоут обновляет `Address` организации).
  addressLine            String?
  city                   String?
  latitude               Float?
  longitude              Float?
  addressSourceProvider  String?
  addressSourceReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedOnOrganization Organization[]                               @relation("OrganizationPublishedRevision")
  serviceCategories       OrganizationProfileRevisionServiceCategory[]

  @@index([organizationId])
  @@index([organizationId, status])
}

/// Подкатегории витрины, привязанные к черновику ревизии (до одобрения — копируются в `OrganizationServiceCategory`).
model OrganizationProfileRevisionServiceCategory {
  revisionId        String
  serviceCategoryId String

  revision        OrganizationProfileRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory             @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@id([revisionId, serviceCategoryId])
  @@index([serviceCategoryId])
}

/// Тип элемента галереи (видео — на будущее).
enum GalleryMediaKind {
  image
  video
}

/// Переиспользуемая галерея медиа; владелец задаётся парой `ownerKind` + `ownerId`.
model Gallery {
  id        String           @id @default(uuid())
  ownerKind GalleryOwnerKind
  ownerId   String
  createdAt DateTime         @default(now())
  items     GalleryItem[]

  @@unique([ownerKind, ownerId])
  @@index([ownerId])
}

/// Элемент галереи; порядок отображения — `sortOrder` (меньше = раньше в слайдере / первая «обложка» для витрины организации).
model GalleryItem {
  id        String  @id @default(uuid())
  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  kind      GalleryMediaKind @default(image)
  sortOrder Int              @default(0)

  createdAt DateTime @default(now())

  @@index([galleryId, sortOrder])
}

/// Локализованные название и описание организации (витрина / SEO на разных языках).
model OrganizationLocale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locale      String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, locale])
  @@index([locale])
}

/// Выбранные подкатегории каталога у организации (витрина / фильтры).
model OrganizationServiceCategory {
  organizationId    String
  serviceCategoryId String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([organizationId, serviceCategoryId])
  @@index([serviceCategoryId])
}

/// Отзыв о организации.
model OrganizationReview {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  /// Привязка к завершённому бронированию (верифицированный отзыв), опционально.
  bookingId String?  @unique
  booking   Booking? @relation("OrganizationReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  rating              Int
  /// Текст после одобрения; виден во витрине гостям.
  publishedComment    String? @db.Text
  /// Не опубликованный черновик (на проверке); сам автор может видеть в API отдельно.
  pendingCommentDraft String? @db.Text

  /// Публикация текста отзыва во витрине (`approved` только после AI/ручного решения при необходимости).
  publicationModerationStatus PublicationModerationStatus @default(approved)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([authorUserId])
}

/// Черновик витринного профиля мастера (`listingName`, `bio`, фото); промоут копирует в строку `Specialist`.
model SpecialistProfileRevision {
  id           String     @id @default(uuid())
  specialistId String
  specialist   Specialist @relation("SpecialistProfileRevisions", fields: [specialistId], references: [id], onDelete: Cascade)

  status SpecialistProfileRevisionStatus @default(pending_review)

  listingName String?
  bio         String?
  imageUrl    String?
  imageAlt    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedOnSpecialist Specialist[] @relation("SpecialistPublishedRevision")

  @@index([specialistId])
  @@index([specialistId, status])
}

/// Профиль специалиста (мастер), 1:1 с пользователем со «статусом специалиста».
model Specialist {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  experienceYears Int?

  /// Имя мастера на витрине (каталог, карточка записи). Не путать с `User.name` (личный клиентский профиль).
  listingName   String?
  ratingAverage Float             @default(0)
  reviewsCount  Int               @default(0)
  imageUrl      String?
  imageAlt      String?
  gender        SpecialistGender?

  /// Уже промодерированный снимок витрины для гостей; черновик правок — в `SpecialistProfileRevision` до промоута.
  publishedProfileRevisionId String?                    @unique
  publishedProfileRevision   SpecialistProfileRevision? @relation("SpecialistPublishedRevision", fields: [publishedProfileRevisionId], references: [id], onDelete: SetNull)

  /// Публикация полей профиля для каталога. Гостевая витрина при pending/rejected — снимок из опубликованной ревизии (`publishedProfileRevisionId`).
  profilePublicationModerationStatus PublicationModerationStatus @default(approved)

  /// Параметры, специфичные для вертикали «массаж» (сила нажима и т.д.); другие крупные категории — отдельные 1:1.
  massageProfile SpecialistMassageProfile?

  /// Режим работы из онбординга; null пока пользователь не выбрал («как работаете»).
  onboardingWorkPattern SpecialistWorkPattern?

  /// Текущее место приёма (адрес и гео для витрины берутся от этой организации).
  activeOrganizationId String?
  activeOrganization   Organization? @relation("SpecialistActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  /// Показывать в клиентском каталоге/поиске как мастера (запись к человеку). Не путать с ролью в организации: владелец без приёма — false.
  listedInDirectory Boolean @default(false)

  /// Завершён сценарий первичной настройки (финальный экран); витрина — только вместе с `activeOrganizationId` и флагом listed.
  onboardingCompletedAt DateTime?

  /// Записи сразу в `confirmed` (без ожидания ручного подтверждения мастером / без pending).
  autoConfirmBookings Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profileRevisions SpecialistProfileRevision[] @relation("SpecialistProfileRevisions")

  employments             SpecialistOrganizationEmployment[]
  workplaceJoinRequests   SpecialistWorkplaceJoinRequest[]
  bookings                Booking[]
  reviews                 SpecialistReview[]
  skills                  SpecialistSkill[]
  onboardingMajorPicks    SpecialistOnboardingMajorServiceCategory[]
  offeringsExecution      SpecialistOffering[]
  timeOffs                SpecialistTimeOff[]
  calendarResources       CalendarResource[]
  resume                  SpecialistResume?
  hiringContacts          HiringContact[]
  jobApplications         JobApplication[]
  organizationInvitations OrganizationSpecialistInvitation[]
  hiringSearchProjection  SpecialistSearchProjection?

  @@index([activeOrganizationId])
}

/// Период недоступности мастера (отпуск, личные дни). Пересечение с активной бронью запрещено при создании записи.
model SpecialistTimeOff {
  id           String     @id @default(uuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  note     String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([specialistId, startsAt])
  @@index([specialistId, endsAt])
}

/// Большие категории (сферы), выбранные на шаге онбординга до создания организации / присоединения к салону.
model SpecialistOnboardingMajorServiceCategory {
  specialistId           String
  majorServiceCategoryId String
  specialist             Specialist           @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  majorServiceCategory   MajorServiceCategory @relation(fields: [majorServiceCategoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([specialistId, majorServiceCategoryId])
  @@index([majorServiceCategoryId])
}

/// Профиль мастера в вертикали «массаж» (онбординг / витрина), чтобы не тащить отраслевые поля в `Specialist`.
model SpecialistMassageProfile {
  specialistId String     @id
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  /// Сила нажима (шкала 1–5); null — ещё не задано в онбординге.
  pressureLevel          Int?
  /// Подстраивать силу под пожелания клиента.
  pressureAdaptsToClient Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Навыки мастера: подкатегории каталога без цены/длительности (прайс — у `OrganizationOffering`).
model SpecialistSkill {
  specialistId      String
  serviceCategoryId String
  specialist        Specialist      @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([specialistId, serviceCategoryId])
  @@index([serviceCategoryId])
}

/// Резюме мастера для hiring-контактов; не заменяет витринный профиль специалиста.
model SpecialistResume {
  id           String     @id @default(uuid())
  specialistId String     @unique
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  /// Автор создания/последней первичной подачи; только audit, не owner для доступа.
  createdByUserId String?
  createdByUser   User?   @relation("SpecialistResumeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  headline        String?
  summary         String?                    @db.Text
  experienceYears Int?
  visibility      SpecialistResumeVisibility @default(private)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([visibility, deletedAt])
  @@index([experienceYears])
}

/// Disposable read projection для поиска кандидатов; source of truth — Specialist, Resume и SpecialistSkill.
model SpecialistSearchProjection {
  specialistId String     @id
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  skillsCategoryIds String[]
  experienceYears   Int?
  textSearch        String?  @db.Text

  updatedAt DateTime @updatedAt

  @@index([experienceYears])
}

/// Период работы специалиста в организации (история смены салонов).
model SpecialistOrganizationEmployment {
  id             String       @id @default(uuid())
  specialistId   String
  specialist     Specialist   @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Права в рамках этой организации (см. `Organization.ownerUserId` для владельца-сущности).
  role OrganizationMembershipRole @default(specialist)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialistId])
  @@index([organizationId])
  @@index([isActive])
  @@index([role])
}

/// Ресурс календаря организации. В MVP ресурсом является специалист; позже — кабинеты и оборудование.
model CalendarResource {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type         CalendarResourceType
  specialistId String?
  specialist   Specialist?          @relation(fields: [specialistId], references: [id], onDelete: SetNull)

  name     String
  capacity Int     @default(1)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventResources        CalendarEventResource[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]

  @@index([organizationId, type, isActive, deletedAt])
  @@index([specialistId])
}

/// Календарное событие — единственный source of truth для занятости ресурсов.
model CalendarEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Денормализация для read model; основной FK живёт на Booking.calendarEventId.
  bookingId String?

  startsAt DateTime
  endsAt   DateTime

  type        CalendarEventType
  status      CalendarEventStatus
  blockReason CalendarBlockReason?

  createdByUserId String?
  createdByUser   User?   @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  notes   String?
  version Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  resources CalendarEventResource[]
  audits    CalendarEventAudit[]
  booking   Booking?

  @@index([organizationId, startsAt, endsAt])
  @@index([startsAt, endsAt, status, deletedAt])
  @@index([bookingId])
}

/// Связь события с ресурсами, которые оно занимает.
model CalendarEventResource {
  id         String           @id @default(uuid())
  eventId    String
  event      CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resourceId String
  resource   CalendarResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  role String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, resourceId])
  @@index([resourceId])
  @@index([resourceId, eventId])
}

/// Недельное правило доступности ресурса в timezone организации.
model AvailabilityRule {
  id         String           @id @default(uuid())
  resourceId String
  resource   CalendarResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  weekday     Int
  startMinute Int
  endMinute   Int
  type        AvailabilityRuleType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([resourceId, weekday, type, deletedAt])
}

/// Разовое переопределение доступности ресурса на дату в timezone организации.
model AvailabilityOverride {
  id         String           @id @default(uuid())
  resourceId String
  resource   CalendarResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// Календарная дата организации в формате yyyy-MM-dd.
  date     String
  startsAt DateTime?
  endsAt   DateTime?
  type     AvailabilityOverrideType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([resourceId, date, type, deletedAt])
}

/// Аудит служебных block-событий календаря. Для booking lifecycle используется BookingEvent.
model CalendarEventAudit {
  id      String        @id @default(uuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation("CalendarEventAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([actorUserId])
}

/// Заявка специалиста на приём в организацию (без автоматического членства).
model SpecialistWorkplaceJoinRequest {
  id             String                               @id @default(uuid())
  specialistId   String
  organizationId String
  status         SpecialistWorkplaceJoinRequestStatus @default(pending)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  specialist   Specialist   @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([specialistId, organizationId])
  @@index([specialistId, status])
  @@index([organizationId, status])
}

/// Вакансия организации: может быть связана с offering, но не является прайсом услуги.
model JobPosting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation("JobPostingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  organizationOfferingId String?
  organizationOffering   OrganizationOffering? @relation(fields: [organizationOfferingId], references: [id], onDelete: SetNull)

  serviceCategoryId String?
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  title              String
  description        String?                    @db.Text
  requirements       String?                    @db.Text
  experienceMinYears Int?
  role               OrganizationMembershipRole @default(specialist)
  status             JobPostingStatus           @default(draft)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contacts     HiringContact[]
  applications JobApplication[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationOfferingId])
  @@index([serviceCategoryId])
  @@index([createdByUserId])
}

/// Единый hiring-контакт между организацией и специалистом.
model HiringContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdByUser   User?   @relation("HiringContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  source   HiringContactSource
  status   HiringContactStatus @default(pending)
  isActive Boolean             @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application JobApplication?

  @@index([organizationId, status, isActive, deletedAt])
  @@index([specialistId, status, isActive, deletedAt])
  @@index([jobPostingId])
  @@index([createdByUserId])
}

/// Отклик специалиста на вакансию; состояние контакта живёт в HiringContact.
model JobApplication {
  id        String        @id @default(uuid())
  contactId String        @unique
  contact   HiringContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation("JobApplicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  status             JobApplicationStatus @default(pending)
  message            String?              @db.Text
  jobPostingSnapshot Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([jobPostingId, status, deletedAt])
  @@index([specialistId, status, deletedAt])
  @@index([createdByUserId])
}

/// Приглашение специалиста организацией в команду.
model OrganizationSpecialistInvitation {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation("OrganizationSpecialistInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  targetRole OrganizationMembershipRole             @default(specialist)
  status     OrganizationSpecialistInvitationStatus @default(pending)
  message    String?                                @db.Text
  expiresAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, status, expiresAt, deletedAt])
  @@index([specialistId, status, expiresAt, deletedAt])
  @@index([createdByUserId])
}

/// Отзыв о специалисте.
model SpecialistReview {
  id           String     @id @default(uuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  bookingId String?  @unique
  booking   Booking? @relation("SpecialistReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  rating              Int
  publishedComment    String? @db.Text
  pendingCommentDraft String? @db.Text

  publicationModerationStatus PublicationModerationStatus @default(approved)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([specialistId])
  @@index([authorUserId])
}

/// Элемент очереди ручной модерации (контент не прошёл AI или недоступен AI).
/// Привязка: одна строка ↔ одна модерируемая сущность (`kind` + `subjectId`), без отдельного столбца на каждый тип.
/// При жёстком удалении сущности из приложения удаляйте кейсы здесь же (до переноса раньше срабатывал ON DELETE FK).
model ContentModerationCase {
  id        String                      @id @default(uuid())
  kind      ContentModerationCaseKind
  /// Id модерируемой сущности (смысл задаётся `kind`, см. enum).
  subjectId String
  status    ContentModerationCaseStatus @default(open)

  aiSummary String? @db.Text

  moderatorUserId String?
  moderatorUser   User?   @relation("ContentModerationResolvedBy", fields: [moderatorUserId], references: [id], onDelete: SetNull)

  /// Очередь ручной проверки: назначенный модератор (до resolve).
  assignedToUserId String?
  assignee         User?     @relation("ContentModerationCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  priority         Int       @default(0)
  attemptCount     Int       @default(0)
  lastProcessedAt  DateTime?

  /// Безопасная выдача воркеру (lease): кто держит блокировку и до какого момента.
  lockedByUserId String?
  lockHolder     User?     @relation("ContentModerationCaseLockHolder", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  lockedUntil    DateTime?

  moderatorReason String? @db.Text

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, subjectId])
  @@index([status, createdAt])
  @@index([assignedToUserId])
  @@index([lockedByUserId])
}

/// Неизменяемый снимок брони на момент создания (аудит/UI «как было»). Не обновлять после финализации брони.
model BookingSnapshot {
  bookingId String  @id
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  organizationOfferingId String
  offeringPriceOptionId  String

  /// Отображаемое имя услуги/оффера для клиента на момент записи.
  organizationOfferingTitleSnapshot String?

  organizationNameSnapshot      String?
  specialistDisplayNameSnapshot String?

  /// Детерминированный хэш канонического неизменяемого содержимого: algo|entity|schemaVersion|sha256(...). См. `booking-snapshot.builder`.
  snapshotHash String?

  durationMinutesSnapshot Int
  /// Суммы в минимальных денежных единицах (филсы для VND и т.п.) согласно `currencySnapshot` (ISO 4217).
  priceAmountSnapshot     Int?
  /// ISO 4217 (например VND); сумма — в minor units.
  currencySnapshot        String? @default("VND")

  addressLineSnapshot String?
  citySnapshot        String?

  /// Редкие расширения без миграций; обязательные поля — колонки.
  payload Json?

  /// Версия контракта снимка; сериализатор в домене брони (`booking-snapshot.builder`).
  snapshotSchemaVersion Int @default(1)

  createdAt DateTime @default(now())
}

/// Коммерческое предложение организации (оффер точки) — канонический прайс салона для витрины и записи.
model OrganizationOffering {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  slug              String
  publicationStatus OfferingPublicationStatus @default(draft)
  /// Первый go-live в продаже гостю; не сбрасывается.
  firstPublishedAt  DateTime?
  /// Каждый последующий republish после снятия с продажи.
  lastPublishedAt   DateTime?

  title       String
  description String?
  sortOrder   Int     @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  priceOptions          OfferingPriceOption[]
  specialistAssignments SpecialistOffering[]
  bookings              Booking[]
  jobPostings           JobPosting[]

  @@index([organizationId])
  @@index([organizationId, slug])
}

/// Вариант цены/длительности оффера точки; lifecycle — status + soft-delete.
model OfferingPriceOption {
  id                     String               @id @default(uuid())
  organizationOfferingId String
  organizationOffering   OrganizationOffering @relation(fields: [organizationOfferingId], references: [id], onDelete: Cascade)

  durationMinutes Int
  priceAmount     Int
  currency        String @default("VND")

  status    OfferingPriceOptionStatus @default(active)
  deletedAt DateTime?
  sortOrder Int                       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceOverrides SpecialistOfferingPriceOverride[]
  bookings       Booking[]

  @@index([organizationOfferingId])
  @@index([organizationOfferingId, durationMinutes])
}

/// Исполнитель оффера точки (мастер допущен к SKU).
model SpecialistOffering {
  id String @id @default(uuid())

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  organizationOfferingId String
  organizationOffering   OrganizationOffering @relation(fields: [organizationOfferingId], references: [id], onDelete: Cascade)

  status    SpecialistOfferingStatus @default(active)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceOverrides SpecialistOfferingPriceOverride[]

  @@unique([specialistId, organizationOfferingId])
  @@index([organizationOfferingId])
}

model SpecialistOfferingPriceOverride {
  id                   String             @id @default(uuid())
  specialistOfferingId String
  specialistOffering   SpecialistOffering @relation(fields: [specialistOfferingId], references: [id], onDelete: Cascade)

  offeringPriceOptionId String
  offeringPriceOption   OfferingPriceOption @relation(fields: [offeringPriceOptionId], references: [id], onDelete: Restrict)

  customPrice Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([specialistOfferingId, offeringPriceOptionId])
  @@index([offeringPriceOptionId])
}

/// Теневая копия документа поиска для диффа/отладки (опционально; индекс может жить только во внешнем движке).
model SearchDocumentProjection {
  organizationOfferingId String @id

  /// Контракт JSON (читатели listing); не путать с {@link projectionBuildVersion}.
  schemaVersion Int  @default(1)
  document      Json

  /// Операционная версия сборщика / rebuild.
  projectionBuildVersion Int @default(0)

  updatedAt DateTime @updatedAt
}

/// Запись transactional outbox в той же БД, что OLTP.
model TransactionalOutboxEntry {
  id String @id @default(uuid())

  topic         String
  aggregateType String
  aggregateId   String
  eventType     String

  payload Json

  /// Идемпотентность consumer at-least-once.
  dedupeKey String? @unique

  status       TransactionalOutboxStatus @default(pending)
  lastError    String?                   @db.Text
  createdAt    DateTime                  @default(now())
  dispatchedAt DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

/// Бронирование (запись к специалисту); `status`/слот/`cancel*` — материализованная проекция после `BookingEvent`.
model Booking {
  id String @id @default(uuid())

  calendarEventId String        @unique
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Restrict)

  clientUserId String
  client       User   @relation("ClientBookings", fields: [clientUserId], references: [id], onDelete: Cascade)

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  organizationOfferingId String
  organizationOffering   OrganizationOffering @relation(fields: [organizationOfferingId], references: [id], onDelete: Restrict)

  offeringPriceOptionId String
  offeringPriceOption   OfferingPriceOption @relation(fields: [offeringPriceOptionId], references: [id], onDelete: Restrict)

  /// Локализованный `shortName` подкатегории на момент записи.
  categoryShortNameSnapshot String?
  durationMinutes           Int
  /// Сумма в минимальных денежных единицах валюты currencySnapshot (ISO 4217).
  priceAmountSnapshot       Int?
  /// ISO 4217; priceAmountSnapshot — в minor units этой валюты.
  currencySnapshot          String? @default("VND")

  startsAt DateTime
  endsAt   DateTime

  status BookingStatus @default(pending)

  /// Дедлайн авто-истечения для pending (не подтвердили за N минут).
  pendingExpiresAt DateTime?

  /// Оптимистичная версия строки: инкремент при каждом применённом событии журнала (CAS при append).
  version Int @default(0)

  /// Последний применённый `BookingEvent.localSequence` (проекция синхронизирована с журналом до этого номера включительно).
  lastAppliedSequence Int @default(0)

  /// Короткий замыкатель целостности проекции (SHA-256 hex канонического среза + хвоста журнала). Источник правды — события; поле для reconcile / инвариантов.
  projectionHash String?

  /// Причина отмены/истечения: код (например `pending_confirmation_timeout`) или канонический английский авто-текст.
  cancelReason        String?
  /// Дополнительный комментарий при отмене (например пояснение от мастера); системные отмены часто без текста.
  cancellationComment String?

  /// Когда ушло push-напоминание клиенту о визите (заданный lead); null = ещё не отправляли.
  clientReminderSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  events             BookingEvent[]
  organizationReview OrganizationReview?             @relation("OrganizationReviewBooking")
  specialistReview   SpecialistReview?               @relation("SpecialistReviewBooking")
  snapshot           BookingSnapshot?
  createIdempotency  ClientBookingCreateIdempotency?

  @@index([clientUserId])
  @@index([specialistId])
  @@index([organizationId])
  @@index([startsAt])
  @@index([status])
  @@index([status, pendingExpiresAt])
  @@index([organizationOfferingId])
  @@index([offeringPriceOptionId])
}

/// Идемпотентность `POST /bookings`: повтор с тем же ключом возвращает ту же бронь (в т.ч. после BOOKING_BUSY_RETRY или фоновой обработки BOOKING_QUEUED).
model ClientBookingCreateIdempotency {
  clientUserId   String
  idempotencyKey String
  bookingId      String  @unique
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([clientUserId, idempotencyKey])
  @@index([bookingId])
}

/// Событие жизненного цикла бронирования (append-only журнал домена перед проекцией на строку Booking).
model BookingEvent {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type BookingEventType

  /// Монотонный порядок в рамках брони (строже wall-clock, чем `createdAt`).
  localSequence Int

  /// Идемпотентный append: повтор с тем же ключом и тем же `bookingId` не дублирует событие.
  idempotencyKey String?

  actorKind BookingActorKind

  actorUserId String?
  actor       User?   @relation("BookingEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Тип специфичный payload — схемы Zod по `type`; для BI допускаются расширения через versioned keys.
  payload Json?

  createdAt DateTime @default(now())

  @@unique([bookingId, idempotencyKey])
  @@index([bookingId, localSequence])
  @@index([bookingId, createdAt])
  @@index([bookingId, id])
  @@index([type])
}

/// Рекламное объявление / баннер по слоту показа (`placement`), с мультиязычными текстами.
model Advertisement {
  id        String          @id @default(uuid())
  /// Слот: `home_promo`, `search_banner`, … — выборка по query `placement`.
  placement String
  ownerKind AdvertOwnerKind @default(internal)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Канонические тексты (fallback, обычно en).
  title    String
  subtitle String
  ctaLabel String

  imageUrl  String
  targetUrl String?

  /// Стабильный ключ для сидов (upsert); null у записей из админки / API.
  refKey String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locales AdvertisementLocale[]

  @@index([placement, isActive, deletedAt, sortOrder])
}

model AdvertisementLocale {
  id              String        @id @default(uuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  locale   String
  title    String
  subtitle String
  ctaLabel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advertisementId, locale])
  @@index([locale])
}
