# Nest на хосте (`cd back && npm run start:dev`), когда **не** используете контейнер `back`.
# Скопируйте в `back/.env.local` (в git не коммитится).
#
# Креды Postgres / Redis / MinIO возьмите из корневого `.env` (те же POSTGRES_*, REDIS_PASSWORD, MINIO_ROOT_*).

# Из корневого `.env` после `npm run docker:env` (или скопируйте значение вручную).
JWT_SECRET=

PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Подставьте значения из корневого `.env` (пароль URL-экранируйте при необходимости: @ → %40 и т.д.).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/services?schema=public

# Хост — localhost; пароль как REDIS_PASSWORD в корневом `.env` (тот же, что у redis в compose).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO с хоста (корневой `.env`: MINIO_ROOT_*).
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=services-uploads
S3_REGION=us-east-1
