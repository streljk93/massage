# Шаблон для `back/.env.local` (локальный запуск `cd back && npm run start:dev`).
# В git не коммитится. Файл загружается ПОСЛЕ root `.env` и `back/.env`, поэтому пустые `KEY=`
# здесь перезаписывают значения из других env-файлов.

# ------------------------------------------------------------------------------
# 1) Минимум для запуска на хосте
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/services?schema=public
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2) Что обычно НЕ нужно дублировать (берётся из root `.env`)
# ------------------------------------------------------------------------------
# Оставляйте эти строки закомментированными, если root `.env` уже заполнен.
# Раскомментируйте только если запускаете back изолированно.
# JWT_SECRET=
# REDIS_PASSWORD=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3) Локальные endpoint'ы инфраструктуры
# ------------------------------------------------------------------------------
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=services-uploads
# S3_REGION=us-east-1
