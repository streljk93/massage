# Auth.js (next-auth v5) — см. https://authjs.dev/getting-started/deployment
# Секрет: из корня репозитория `npm run auth:secret` или `npm run auth:secret:write`
# (вручную: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Nest API: email/пароль (register + login в Credentials). Без этого — демо-вход без БД.
AUTH_BACKEND_URL=http://localhost:3001

# Публичный URL API для браузера (аватар, профиль). Локально совпадает с AUTH_BACKEND_URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase Web App (Console → Project settings → Your apps) + Cloud Messaging → Web Push certificates (VAPID key).
# Без этого клиент не запрашивает FCM token; SW `/firebase-messaging-sw.js` отдаётся с пустым конфигом.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Docker Compose (корень репозитория): сервер Next обращается к API по имени сервиса, не localhost.
# В compose задано: AUTH_BACKEND_URL=http://back:3001

# OAuth (опционально: задайте пару ID+SECRET — появится кнопка провайдера)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
