# Auth.js (next-auth v5) — см. https://authjs.dev/getting-started/deployment
# Секрет: из корня репозитория `npm run auth:secret` или `npm run auth:secret:write`
# (вручную: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth (опционально: задайте пару ID+SECRET — появится кнопка провайдера)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
