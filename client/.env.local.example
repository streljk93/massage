# Next.js на хосте (`cd client && npm run dev`), когда **не** используете контейнер `client`.
# Скопируйте в `client/.env.local` (в git не коммитится).
#
# Секреты и URL из корневого `.env` / `.env.example` — без дублирования в `client/.env.example`.
# Для Docker-сборки `client` те же `NEXT_PUBLIC_*` задайте в корневом `.env` — compose передаёт их как `build.args` (см. `client/Dockerfile`).

AUTH_SECRET=
AUTH_URL=http://localhost:3000

AUTH_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Совпадает с GOOGLE_OAUTH_CLIENT_ID на бэке
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# --- Firebase web (опционально) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
