# Скопируйте в `.env` в корне репозитория (файл в git не коммитится).
# `npm run docker:env` дописывает JWT_SECRET и AUTH_SECRET.
#
# Ниже — общие переменные для docker-compose и те же креды, что подставляются
# в сервисы `postgres`, `redis`, `minio` и в `back` (DATABASE_URL, S3, Redis).

JWT_SECRET=
AUTH_SECRET=

# --- PostgreSQL (docker-compose сервис postgres; хост Nest при npm run dev — см. back/.env.local.example) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=services

# --- Redis (requirepass; тот же пароль у Nest: REDIS_PASSWORD) ---
REDIS_PASSWORD=redis-local-dev
# REDIS_MAXMEMORY=256mb

# --- MinIO (S3-совместимое API; у Nest S3_ACCESS_KEY / S3_SECRET_KEY в compose = эти значения) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Имена бакета и региона S3 у back в compose (сервис minio-init создаёт бакет при первом up) ---
S3_BUCKET=services-uploads
S3_REGION=us-east-1

# --- Режим Nest только для dev-compose (`docker-compose.yml`); в prod-файле back всегда production ---
# NODE_ENV=development

# --- Публичные URL (`docker-compose.yml` dev / build client) ---
CLIENT_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
# Сборка образа `client`: задайте `NEXT_PUBLIC_*` здесь — compose передаёт их в образ как `build.args` (см. `client/Dockerfile`: ARG/ENV).
# Новый ключ — добавьте в Dockerfile и в `build.args` у сервиса `client` в compose. После смены — `docker compose build client` / `up --build`.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Опционально (FCM / Google GSI) — те же имена, что в `client/.env.local.example`:
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Dev Docker (`docker-compose.yml`): Ollama только с профилем `ai` ---
# В compose для `back` по умолчанию `ENABLE_OLLAMA=false`. Стек с контейнером Ollama: `npm run docker:up:dev:ai`.
# `npm run init` поднимает `dev`+`ai` и передаёт ENABLE_OLLAMA=true контейнеру `back`.
# ENABLE_OLLAMA=true

# --- Production — `docker-compose.prod.yml` + `npm run docker:up:prod` ---
# RESEND_API_KEY=        # обязательно в prod-контейнере back
# MAIL_FROM=             # From для Resend
# AUTH_URL=https://…    # канонический URL фронта (compose для client — :? )
# CLIENT_ORIGIN=https://…
# NEXT_PUBLIC_API_URL=https://…/api  # build-time; смена без пересборки client не подхватится
# Без профиля `ai` в prod: `ENABLE_OLLAMA=false` (дефолт в compose) или внешний `OLLAMA_BASE_URL` + `ENABLE_OLLAMA=true`.
# Локальный контейнер Ollama в prod: `npm run docker:up:prod:ai` (включает ENABLE_OLLAMA=true).
# OLLAMA_BASE_URL=https://…
# POSTGRES_BACKUP_INTERVAL_SEC=86400
# POSTGRES_BACKUP_KEEP=7
# При параллельном dev на том же хосте: CLIENT_PUBLISH_PORT=3010 BACK_PUBLISH_PORT=3011
