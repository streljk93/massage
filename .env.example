# Скопируйте в `.env` в корне репозитория.
# Этот файл используется `docker-compose.yml` и `docker-compose.prod.yml`.
# `npm run docker:env` заполняет `JWT_SECRET` и `AUTH_SECRET`, если они пустые.

# ------------------------------------------------------------------------------
# 1) Обязательный минимум для Docker Compose (dev и prod)
# ------------------------------------------------------------------------------
JWT_SECRET=
AUTH_SECRET=
CLIENT_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000

POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redis-local-dev
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# 2) Инфраструктура (опционально, есть дефолты в compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=services
S3_BUCKET=services-uploads
S3_REGION=us-east-1
# REDIS_MAXMEMORY=256mb

# ------------------------------------------------------------------------------
# 3) Client build args (Next.js PUBLIC env)
# ------------------------------------------------------------------------------
# Важно: `NEXT_PUBLIC_*` попадают в бандл только на этапе сборки image `client`.
# После изменения пересоберите client: `docker compose build client`.
NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Бесплатно: https://carto.com/basemaps/apikey/ — без ключа на карте watermark CARTO.
# NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY=

# ------------------------------------------------------------------------------
# 4) AI / moderation (опционально)
# ------------------------------------------------------------------------------
# ENABLE_OLLAMA=true
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2
# IMAGE_MODERATION_BASE_URL=http://image-moderation:8085
# MODERATION_CLIP_REVIEW_THRESHOLD=0.7
# MODERATION_QUEUE_ENABLED=true

# ------------------------------------------------------------------------------
# 5) Production-only
# ------------------------------------------------------------------------------
# Обязательно для `docker-compose.prod.yml` (back в production):
# RESEND_API_KEY=
# MAIL_FROM="Services <noreply@example.com>"

# ------------------------------------------------------------------------------
# 6) Порты публикации (если dev/prod запускаются параллельно на одном хосте)
# ------------------------------------------------------------------------------
# CLIENT_PUBLISH_PORT=3000
# BACK_PUBLISH_PORT=3001

# ------------------------------------------------------------------------------
# 7) Бэкапы Postgres (профиль `backup`)
# ------------------------------------------------------------------------------
# POSTGRES_BACKUP_INTERVAL_SEC=86400
# POSTGRES_BACKUP_KEEP=7
